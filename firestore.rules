rules_version = '2';

// SmartChurch Firestore 보안 규칙
// - 전체 허용(catch-all `match /{document=**}`)을 제거하고 컬렉션마다 명시적으로 정의.
// - 소유자는 문서 ID가 아니라 필드로 판별되는 경우가 많음(userId/authorId/fromId·toId/createdById).
// - 리더/관리자 교차 쓰기는 호출자의 users 문서를 get() 해서 판별.
// ⚠️ 콘솔에 적용 후 반드시 주요 흐름(로그인·가입승인·직분변경·채팅·바인더 동기화)을 테스트하세요.
//    문제가 생기면 콘솔 규칙 히스토리에서 이전 버전으로 롤백.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ──
    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(uid())); }
    function profile()    { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function isAdmin()  { return signedIn() && hasProfile() && profile().isAppAdmin == true; }
    // 직분(role)은 본인이 자기 문서에 쓸 수 있으므로 권한의 근거가 될 수 없다.
    // 아무나 role 을 '담임목사' 로 바꾸면 교인 관리·전화번호 열람까지 열렸다.
    // → 리더 직분은 leaderStatus == 'approved' (앱 관리자만 부여) 를 함께 요구한다.
    // 직분 이름은 더 이상 여기서 검사하지 않는다. 기관·단체는 직분을 스스로 정하므로
    // ('센터장' 처럼) 목록에 없는 이름이 얼마든지 나오고, 그러면 앱 관리자가 승인해 준 리더가
    // 서버에서만 막혀 "화면엔 보이는데 저장이 안 되는" 상태가 된다.
    // leaderStatus 는 selfKeepsPrivileges 가 본인 수정으로는 'pending' 까지만 허용하므로
    // 'approved' 는 앱 관리자(또는 이미 승인된 리더)가 써 준 값뿐이다 — 그 자체로 충분한 근거다.
    // 리더 권한은 공동체마다 따로 둔다 (churchLeaders/{코드}_{uid}).
    // users 문서에 두면 칸이 하나뿐이라, 공동체를 옮길 때 반드시 지워야 했고(안 지우면 A교회
    // 리더가 B교회 코드만 넣고 명부·전화번호를 연다) 돌아와도 되살릴 길이 없었다.
    // 이 문서는 본인이 못 쓴다 — 그래서 권한의 근거가 될 수 있다.
    function orgLeaderExists() {
      return hasProfile() && profile().get('churchCode', '') != ''
          && exists(/databases/$(database)/documents/churchLeaders/$(profile().get('churchCode', '') + '_' + uid()));
    }
    function orgLeaderDoc() {
      return get(/databases/$(database)/documents/churchLeaders/$(profile().get('churchCode', '') + '_' + uid())).data;
    }
    function orgLeaderApproved() {
      return orgLeaderExists() && orgLeaderDoc().get('leaderStatus', '') == 'approved';
    }
    function orgPerms() {
      return orgLeaderExists() ? orgLeaderDoc().get('leaderPerms', []) : [];
    }
    // 레거시(users.leaderStatus)는 그대로 둔다 — 아직 이관 안 된 리더가 한 번에 권한을 잃으면
    // 스스로 되살릴 방법이 없다(문서를 만들 권한조차 리더여야 생긴다). 공동체를 옮길 때
    // 앱이 users.leaderStatus 를 비우므로, 이 갈래도 지금 있는 공동체에만 유효하다.
    function leaderApproved() {
      return profile().get('leaderStatus', '') == 'approved' || orgLeaderApproved();
    }
    // 임명 리더(leaderPerms)는 여기 들어오지 않는다. 권한이 하나라도 있으면 리더로 쳤더니
    // '게시판' 하나만 임명받은 사람에게도 교인 전화번호와 교회 정보 수정이 열렸다.
    // 임명받은 일은 hasPerm(권한) 으로 각자 확인한다.
    function isLeader() {
      return signedIn() && hasProfile() && (
        profile().isAppAdmin == true ||
        leaderApproved()
      );
    }
    // 리더라도 '자기 교회 오픈채팅' 또는 '자기가 속한 방'에서만 남의 메시지를 지울 수 있다.
    // isLeader() 만 보면 방 id 만 알면 다른 교회 대화도 건드릴 수 있다.
    function canModerateRoom(roomId) {
      return isLeader()
          && (get(/databases/$(database)/documents/chatRooms/$(roomId)).data.get('churchCode', '') == profile().churchCode
              || uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.get('members', []));
    }
    function hasPerm(p) {
      return signedIn() && hasProfile() && (
        profile().isAppAdmin == true ||
        leaderApproved() ||
        (profile().leaderPerms is list && p in profile().leaderPerms) ||
        // 이 공동체에서 임명받은 권한 (공동체를 옮겨도 각자 제자리에 남는다)
        (orgPerms() is list && p in orgPerms())
      );
    }
    // 본인 수정으로는 권한을 스스로 올릴 수 없다. role 은 계속 자유롭게 바꿀 수 있고
    // (온보딩에서 직분을 고르므로) leaderStatus 는 신청('pending')까지만 허용한다.
    function selfKeepsPrivileges() {
      return request.resource.data.get('isAppAdmin', false) == resource.data.get('isAppAdmin', false)
          && (request.resource.data.get('leaderPerms', []) == resource.data.get('leaderPerms', [])
              || request.resource.data.get('leaderPerms', []).size() == 0)   // 내려놓는 것만 허용 (교회를 옮기면 비운다)
          && request.resource.data.get('status', '')      == resource.data.get('status', '')
          && (request.resource.data.get('leaderStatus', '') == resource.data.get('leaderStatus', '')
              || request.resource.data.get('leaderStatus', '') == 'pending')
          // 승인 없이 교인이 되는 것을 막는다. churchStatus 가 막혀 있지 않아서, SDK 로 자기
          // 문서에 churchStatus:'active' 와 남의 churchCode 를 써 넣으면 그대로 교인이 됐다
          // (교인 명단·교회 채팅방이 보인다). 'active' 로 올리는 건 리더/관리자만 한다.
          // 본인은 '' · 'pending' · 'church-pending' 등 무엇이든 쓸 수 있고, 이미 'active'
          // 였다면 그대로 두는 것만 허용한다 — 이름을 고치는 평범한 수정이 막히면 안 된다.
          // 교회를 옮기면서 'active' 를 들고 가는 것도 막는다(다른 교회로 무단 이동).
          && (request.resource.data.get('churchStatus', '') != 'active'
              // 이미 그 교회에서 활성이던 사람이 이름 등 다른 것을 고치는 평범한 수정.
              // 부분 수정도 규칙에는 병합된 최종 문서가 오므로, 이게 없으면 전부 거부된다.
              || (resource.data.get('churchStatus', '') == 'active'
                  && request.resource.data.get('churchCode', '') == resource.data.get('churchCode', ''))
              // 전에 승인받았던 공동체로 돌아오기(재승인 면제). 반드시 '서버에 이미 있는'
              // 기록만 본다 — 이번 요청에 함께 실려 온 목록을 믿으면 스스로 통행증을 쓴다.
              || resource.data.get('approvedChurches', []).hasAny([request.resource.data.get('churchCode', '')])
              // 초대 코드로 입장. 코드를 아는 것이 곧 승인이다(목록 조회는 아래에서 막았다).
              || invitedTo(request.resource.data.get('joinedViaCode', ''),
                           request.resource.data.get('churchCode', ''))
              // 그 공동체 리더가 승인한 신청서가 있으면 입장. 원래 소속을 유지한 채 신청할 수
              // 있게 하려고 신청서를 users 밖(joinRequests)으로 뺐고, 그 결과가 여기로 들어온다.
              || joinApproved(request.resource.data.get('churchCode', '')))
          // 승인 이력은 '지금 활성인 그 교회'만 덧붙일 수 있다. 아니면 위의 '돌아오기'가
          // 아무 교회나 적어 넣을 수 있는 무한 통행증이 된다.
          && (request.resource.data.get('approvedChurches', []) == resource.data.get('approvedChurches', [])
              || (resource.data.get('churchStatus', '') == 'active'
                  && request.resource.data.get('approvedChurches', [])
                       .hasOnly(resource.data.get('approvedChurches', [])
                                  .concat([resource.data.get('churchCode', '')]))));
    }

    // 그 공동체 리더가 실제로 승인한 신청서가 서버에 있는지 직접 확인한다.
    // 초대 코드(invitedTo)와 같은 모양 — 이번 요청에 실려 온 값이 아니라 이미 저장된 문서만 본다.
    // 신청서 id 가 uid_코드 로 고정이라 남의 승인서를 가리킬 수 없다.
    function joinApproved(code) {
      return code != ''
          && exists(/databases/$(database)/documents/joinRequests/$(uid() + '_' + code))
          && get(/databases/$(database)/documents/joinRequests/$(uid() + '_' + code)).data.get('status', '') == 'approved';
    }

    // 가입 신청을 처리할 수 있는 사람 — 그 공동체의 리더/가입승인 임명자, 또는 앱 관리자.
    // 아래 users 수정 규칙과 같은 기준이다.
    function canApproveFor(code) {
      return signedIn() && hasProfile() && (
        isAdmin() || ((isLeader() || hasPerm('approve') || hasPerm('newfamily'))
                      && profile().churchCode == code)
      );
    }

    // 초대 코드를 실제로 들고 있는지 서버가 직접 확인한다. 코드 문서의 churchCode 와
    // 들어가려는 교회가 같아야 한다 — 아무 코드나 들고 다른 교회에 들어가지 못하게.
    function invitedTo(code, churchCode) {
      return code != '' && churchCode != ''
          && exists(/databases/$(database)/documents/inviteCodes/$(code))
          && get(/databases/$(database)/documents/inviteCodes/$(code)).data.get('churchCode', '') == churchCode;
    }

    // 가입은 update 를 거치지 않으므로 selfKeepsPrivileges 가 닿지 않는다.
    // 앱은 늘 권한 없는 문서를 만들지만, 웹 API 키가 공개돼 있어 SDK 로 직접 가입하면서
    // 처음부터 leaderStatus:'approved' 를 써 넣으면 그대로 리더가 됐다.
    function selfCreateIsPlain() {
      return request.resource.data.get('isAppAdmin', false) == false
          && request.resource.data.get('leaderPerms', []).size() == 0
          && request.resource.data.get('leaderStatus', '') in ['', 'pending'];
    }

    // ── 사용자 프로필 ──
    // 읽기: 로그인한 교인 누구나(교인 목록). 생성: 본인 가입 또는 관리자 벌크 동기화.
    // 수정: 본인 / 관리자 / 같은 교회 리더(가입승인·직분·리더임명). 삭제: 본인(회원탈퇴) / 관리자.
    match /users/{userId} {
      allow read:   if signedIn();
      allow create: if signedIn() && ((uid() == userId && selfCreateIsPlain()) || isAdmin());
      allow update: if signedIn() && (
                      (uid() == userId && selfKeepsPrivileges()) ||
                      isAdmin() ||
                      // 가입 승인·새가족 등록을 임명받은 사람도 같은 교회 교인 문서를 고쳐야 한다
                      ((isLeader() || hasPerm('approve') || hasPerm('newfamily'))
                       && resource.data.churchCode == profile().churchCode)
                    );
      allow delete: if signedIn() && (uid() == userId || isAdmin());
    }

    // ── 공동체별 리더 권한 (churchLeaders/{코드}_{uid}) ──
    // 본인은 절대 못 쓴다 — 쓸 수 있으면 권한의 근거가 될 수 없다. 세우는 건 그 공동체의
    // 승인된 리더이거나 앱 관리자뿐이고, 문서 id 를 코드_uid 로 못박아 남의 공동체에
    // 자기 사람을 심지 못하게 한다(리더는 자기 공동체 코드로만 id 를 맞출 수 있다).
    // 아직 이관 안 된 레거시 리더는 leaderApproved() 의 users 갈래로 통과해 자기 문서를
    // 만들 수 있다 — 지금 그 공동체에서 이미 가진 권한을 옮겨 적는 것뿐이라 상승이 아니다.
    match /churchLeaders/{leaderId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                    && leaderId == request.resource.data.get('churchCode', '') + '_' + request.resource.data.get('userId', '')
                    && (isAdmin() || (leaderApproved()
                                      && request.resource.data.get('churchCode', '') == profile().churchCode));
      allow delete: if signedIn()
                    && (isAdmin() || (leaderApproved()
                                      && resource.data.get('churchCode', '') == profile().churchCode));
    }

    // ── 공동체 가입 신청 (joinRequests/{uid}_{code}) ──
    // users 의 공동체 칸은 하나뿐이라, 거기에 pending 을 쓰면 원래 소속이 덮여 사라진다.
    // 그래서 신청서를 밖으로 뺐다. 승인 결과는 위 joinApproved() 가 읽어 입장을 허락한다.
    // id 를 uid_코드 로 못박아 남의 이름으로 신청서를 만들 수 없게 한다.
    match /joinRequests/{reqId} {
      allow read:   if signedIn() && (resource.data.userId == uid()
                                      || canApproveFor(resource.data.get('churchCode', '')));
      allow create: if signedIn()
                    && request.resource.data.userId == uid()
                    && reqId == uid() + '_' + request.resource.data.get('churchCode', '')
                    // 스스로 승인된 신청서를 만들어 입장하는 것을 막는다 — 시작은 늘 'pending'.
                    && request.resource.data.get('status', '') == 'pending';
      // 결정은 그 공동체 리더만. 본인은 취소(삭제)만 할 수 있다.
      allow update: if signedIn()
                    && canApproveFor(resource.data.get('churchCode', ''))
                    && request.resource.data.userId     == resource.data.userId
                    && request.resource.data.churchCode == resource.data.churchCode;
      allow delete: if signedIn() && (resource.data.userId == uid()
                                      || canApproveFor(resource.data.get('churchCode', '')));
    }

    // ── 프로필 사진 (문서 ID = uid) ──
    // 본인 또는 리더/관리자(구버전 계정 사진 대신 등록 backfillOtherPhoto).
    match /userPhotos/{photoId} {
      allow read:  if signedIn();
      allow write: if signedIn() && (uid() == photoId || isLeader());
    }

    // ── 전화번호 (문서 ID = uid) ──
    // users 문서는 read: signedIn 이라 거기에 두면 모든 교인이 읽는다. 그래서 분리했다.
    // 읽기: 본인 / 앱 관리자(운영 목적 열람) / 같은 교회 리더. 그 외 교인은 서버에서 차단된다.
    // ※ 파라미터명을 phoneUid 로 둔 이유 — uid 로 쓰면 헬퍼 함수 uid() 를 가린다.
    match /userPhones/{phoneUid} {
      allow read: if signedIn() && (
                    uid() == phoneUid ||
                    isAdmin() ||
                    (isLeader() &&
                     exists(/databases/$(database)/documents/users/$(phoneUid)) &&
                     get(/databases/$(database)/documents/users/$(phoneUid)).data.churchCode == profile().churchCode)
                  );
      allow write: if signedIn() && (uid() == phoneUid || isAdmin());
    }

    // ── 공유 바인더 (key = uid_date, 교회 내 공개 열람) ──
    // isAdmin: 계정 삭제 시 딸린 데이터를 지우려면 남의 문서도 지울 수 있어야 한다.
    match /binderEntries/{key} {
      allow read:  if signedIn();
      allow write: if signedIn() && (key.split('_')[0] == uid() || isAdmin());
    }

    // ── 개인 바인더 기기 동기화 (key = uid_date, 본인만 — 비공개) ──
    // 관리자에게도 read 는 주지 않는다(남의 개인 묵상 열람). 계정 삭제용으로 write 만 연다.
    match /myBinders/{key} {
      allow read:  if signedIn() && key.split('_')[0] == uid();
      allow write: if signedIn() && (key.split('_')[0] == uid() || isAdmin());
    }

    // ── 투두 기기 동기화 (key = uid_date, 본인만 — 비공개) ──
    match /myTodos/{key} {
      allow read:  if signedIn() && key.split('_')[0] == uid();
      allow write: if signedIn() && (key.split('_')[0] == uid() || isAdmin());
    }

    // ── 공유 바인더 코멘트 (소유자 필드 authorId) ──
    // 생성: 작성자 본인. 수정/삭제: 작성자 또는 바인더 권한 리더(모더레이션).
    match /binderComments/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update, delete: if signedIn() && (
                      resource.data.authorId == uid() || hasPerm('binder')
                    );
    }

    // ── 챌린지 (소유자 필드 createdByUid) ──
    match /challenges/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
                      resource.data.createdByUid == uid() || isLeader() || hasPerm('challenge-manage')
                    );
    }

    // ── 챌린지 인증샷 (문서 ID = {uid}_{챌린지}_{날짜}) ──
    // 사진을 users 문서에 넣지 않으려고 따로 뒀다 — users 는 교인 누구나 읽고, 1MB 한도도
    // 사진 몇 장이면 찬다. 쓰기는 본인만(userId 검사), 삭제는 본인 또는 리더(모더레이션).
    match /challengeProofs/{id} {
      allow read:   if signedIn();
      allow create, update: if signedIn() && request.resource.data.userId == uid();
      // 삭제: 본인 / 리더(모더레이션) / 1주가 지나 만료된 것은 본 사람이 정리한다.
      // 채팅 사진과 같은 이유 — 예약 정리(Cloud Functions)가 Blaze 전용이라 못 쓴다.
      // createdAt 은 serverTimestamp 라 기기 시계를 되돌려도 만료를 앞당길 수 없다.
      allow delete: if signedIn() && (
                      resource.data.userId == uid()
                      || isLeader()
                      || (resource.data.createdAt is timestamp
                          && resource.data.createdAt < request.time - duration.value(7, 'd'))
                    );
    }

    // ── 게시판 글 (소유자 필드 authorId) ──
    // 수정은 로그인 누구나 허용(좋아요 likes[] 를 모든 교인이 갱신). 삭제는 작성자/관리자.
    match /boardPosts/{postId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());

      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == uid();
        allow update: if signedIn() && resource.data.authorId == uid();
        allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());
      }

      // 첨부 사진(글당 최대 10장). base64 라 글 문서에 넣으면 1MB 한도를 넘고,
      // 목록은 글 50개를 한 번에 읽어 사진까지 딸려 오면 감당이 안 된다.
      match /photos/{photoId} {
        allow read:   if signedIn();
        allow create, update: if signedIn() && request.resource.data.authorId == uid();
        allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());
      }
    }
    // 탈퇴 시 남의 글에 단 내 댓글까지 지우려면 collectionGroup('comments') 조회가 필요하다.
    // 위 중첩 규칙은 컬렉션 그룹 쿼리에 적용되지 않아 이 wildcard 매치가 따로 있어야 한다(삭제는 위 규칙이 판단).
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    // ── 친구 요청 (id = fr_{fromId}_{toId}, 당사자만) ──
    match /friendRequests/{id} {
      allow read:   if signedIn() && (resource.data.fromId == uid() || resource.data.toId == uid());
      allow create: if signedIn() && request.resource.data.fromId == uid();
      allow update, delete: if signedIn() && (resource.data.fromId == uid() || resource.data.toId == uid() || isAdmin());
    }

    // ── 매칭 프로필 (소유자 필드 userId) ──
    match /matchProfiles/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ── 매칭 요청 (당사자 fromId/toId) ──
    match /matchRequests/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.fromId == uid();
      allow update, delete: if signedIn() && (resource.data.fromId == uid() || resource.data.toId == uid() || isAdmin());
    }

    // ── 오픈채팅 채널 (소유자 필드 createdBy, 리더 승인/삭제) ──
    match /openChannels/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if signedIn() && (resource.data.createdBy == uid() || isLeader());
    }

    // ── 모임/회의 (소유자 필드 createdById, 리더 생성) ──
    match /meetings/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdById == uid();
      allow update, delete: if signedIn() && resource.data.createdById == uid();
    }

    // ── 교회 상세정보 (문서 ID = 교회코드, 리더/관리자만 수정) ──
    match /churchInfo/{code} {
      allow read:  if signedIn();
      allow write: if isLeader();
    }

    // ── 행사 (소유자 필드 createdById). 티켓 신청/취소는 모든 교인이 ticketCount 갱신 → update 개방 ──
    match /events/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdById == uid() && (isLeader() || hasPerm('ticketing'));
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.createdById == uid();
    }

    // ── 채팅방 + 메시지 (공유 문서 — 교인 누구나 참여) ──
    match /chatRooms/{roomId} {
      allow read, create, update: if signedIn();
      match /messages/{msgId} {
        allow read:   if signedIn();
        allow create: if signedIn() && (request.resource.data.senderId == uid() || request.resource.data.senderId == 'system');
        // 예전에는 allow update: if signedIn() 이라, 로그인만 하면 남의 메시지 본문을
        // 통째로 고쳐 쓸 수 있었다. 이제 '삭제 표시'만 허용한다 — 본문·발신자는 못 건드린다.
        // 실제로 지우지 않고 표시만 하는 이유: 문서를 없애면 리더가 지운 기록도 사라지고,
        // 다른 사람 화면에 남아 있던 것과 어긋난다.
        allow update: if signedIn() && (
                        // ① 삭제 표시 — 본인 또는 그 방을 관리할 수 있는 리더.
                        // 지울 때 본문(text)과 사진(imageUrl)도 같이 비운다. 안 그러면 화면엔
                        // '삭제된 메시지입니다' 로 보여도 원문이 문서에 그대로 남고, 메시지는
                        // 로그인한 교인이면 누구나 읽을 수 있어 그냥 꺼내 볼 수 있다.
                        // 그 키들을 열되 '비우기' 아니면 '그대로' 만 허용한다 — 지우는 척하며
                        // 다른 내용을 끼워 넣지 못하게. '그대로' 를 허용하는 건 아직 옛 JS 를
                        // 들고 있는 앱이 삭제를 못 하는 일이 없게 하기 위해서다.
                        (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['deleted', 'deletedBy', 'deletedAt',
                                     'text', 'imageUrl', 'imageExpired'])
                         && request.resource.data.get('deleted', false) == true
                         && request.resource.data.get('deletedBy', '') == uid()
                         && (request.resource.data.get('text', '') == ''
                             || request.resource.data.get('text', '')
                                == resource.data.get('text', ''))
                         && (request.resource.data.get('imageUrl', '') == ''
                             || request.resource.data.get('imageUrl', '')
                                == resource.data.get('imageUrl', ''))
                         && (resource.data.get('senderId', '') == uid() || canModerateRoom(roomId)))
                        ||
                        // ② 이모지 리액션 — 남의 메시지에도 달 수 있어야 하므로 발신자를 따지지
                        // 않는다. 대신 reactions 말고는 아무것도 못 바꾸게 막고, 이미 지운
                        // 메시지에는 못 달게 한다.
                        // 한계: reactions 맵 안의 배열에 누구 uid 가 들어가는지까지는 규칙으로
                        //       볼 수 없다. 남의 이름으로 누른 척은 가능하지만 게시판 좋아요와
                        //       같은 수준이라 여기서 멈춘다.
                        (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reactions'])
                         && resource.data.get('deleted', false) == false)
                        ||
                        // ③ 1주 지난 사진 비우기 — 사진이 문서에 base64 로 들어 있어 그냥 두면
                        // 무료 요금제 저장 용량만 먹는다. 예약 정리(Cloud Functions)는 Blaze
                        // 전용이라, 그 방을 연 사람이 발견하는 대로 비운다.
                        // 비우는 것 말고는 못 하게: imageUrl 은 반드시 빈 문자열이어야 하고
                        // (다른 사진으로 갈아끼우기 차단), 1주가 지난 메시지여야 한다.
                        (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['imageUrl', 'imageExpired'])
                         && request.resource.data.get('imageUrl', '') == ''
                         && request.resource.data.get('imageExpired', false) == true
                         && resource.data.createdAt is timestamp
                         && resource.data.createdAt < request.time - duration.value(7, 'd'))
                      );
        allow delete: if false;   // 되살릴 수 없는 진짜 삭제는 막는다
      }
    }

    // ── 초대 코드 (코드 = 문서 ID) ──
    // 읽기 공개(온보딩 코드 확인). 생성: invite 권한 리더. 사용(usedBy arrayUnion): 로그인 누구나. 삭제: 리더.
    // ── 초대 코드 ──
    // 예전에는 read: if true 였다. 로그인조차 없이 컬렉션을 통째로 훑어 유효한 코드를
    // 골라낼 수 있었고, 그러면 위에서 막은 무단 가입을 '정식 경로'로 그냥 해버린다.
    // 코드를 '아는' 사람만 쓰라는 것이 초대 코드의 뜻이므로, 문서 하나를 콕 집어 읽는
    // get 만 열고 목록 조회(list)는 막는다. 앱은 getDoc(code) 로만 읽어서 영향이 없다.
    match /inviteCodes/{code} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if hasPerm('invite');
      // 사용 기록(usedBy)만 남길 수 있다. 예전에는 signedIn 이면 무엇이든 고칠 수 있어
      // 만료일을 늘리거나 다른 교회 코드로 바꿔치기할 수 있었다.
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']);
      allow delete: if isLeader();
    }

    // ── 행사 예약 (churchData/{code}/events/{id}/reservations/{uid}) ──
    // 예약 목록 읽기(참석자 수)는 교인 공개. 쓰기는 본인 예약만.
    match /churchData/{churchCode}/events/{eventId}/reservations/{resUid} {
      allow read:  if signedIn();
      allow write: if signedIn() && (resUid == uid() || isAdmin());
    }
    // 내 예약 전체조회(collectionGroup 'reservations') 대응
    match /{path=**}/reservations/{resId} {
      allow read:  if signedIn();
    }
  }
}
